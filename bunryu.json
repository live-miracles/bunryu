{
    "port": 8080,
    "hook_port": 8082,
    "trust_proxy": 0,
    "database_path": "./db.sqlite",
    "srs_config_path": "./srs.conf",
    "ffmpeg_path": "./objs/ffmpeg",
    "ffprobe_path": "./objs/ffprobe",
    "dashboard_password": "admin",
    "stream_key_count": 100,
    "output_watchdog": {
        "warmup_ms": 90000,
        "stall_ms": 45000,
        "interval_ms": 5000,
        "socket_warmup_ms": 15000,
        "socket_grace_ms": 30000,
        "memory_limit_mb": 200,
        "memory_limit_mb_by_encoding": {
            "vertical_rotate": 450,
            "720p": 650,
            "1080p": 950
        }
    }
}
